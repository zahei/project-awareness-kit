#!/usr/bin/env python3
"""
pak v2.1 — Project Awareness Kit CLI, Upgrader & Multi-Agent / Multi-Microservice Installer
Compatible with Google (Antigravity `agy` / Gemini CLI), Anthropic (`claude` Claude Code),
and OpenAI (`codex` Codex CLI) + Cursor/Windsurf (`AGENTS.md`).
"""

from __future__ import annotations

import argparse
import json
import os
import shutil
import sqlite3
import stat
import subprocess
import sys
from pathlib import Path
from typing import Any, Dict, List, Set

PAK_VERSION = "2.1.2"
PAK_ROOT = Path(__file__).resolve().parent
TEMPLATES_DIR = PAK_ROOT / "templates"

PAK_MD_START = "<!-- PAK:START -->"
PAK_MD_END = "<!-- PAK:END -->"
PAK_SH_START = "# --- PAK:START ---"
PAK_SH_END = "# --- PAK:END ---"

SKILL_NAMES = ("pak-atlas", "pak-impact", "pak-domains", "pak-bootstrap")
ENGINE_SCRIPTS = ("build_atlas.py", "blast_radius.sh", "verify_impact.sh", "affected_tests.py")

CYAN = "\033[0;36m"
GREEN = "\033[0;32m"
YELLOW = "\033[0;33m"
BOLD = "\033[1m"
RESET = "\033[0m"


def ask_choice(prompt: str, options: List[tuple[str, str]], default_idx: int = 1) -> str:
    print(f"\n{BOLD}{prompt}{RESET}")
    for idx, (_, label) in enumerate(options, 1):
        rec = f" {GREEN}(default){RESET}" if idx == default_idx else ""
        print(f"  [{idx}] {label}{rec}")
    while True:
        raw = input(f"{CYAN}Select [1-{len(options)}] (Enter={default_idx}): {RESET}").strip()
        if not raw:
            return options[default_idx - 1][0]
        if raw.isdigit() and 1 <= int(raw) <= len(options):
            return options[int(raw) - 1][0]
        print(f"{YELLOW}Please enter a number between 1 and {len(options)}.{RESET}")


def ask_yes_no(prompt: str, default: bool = False) -> bool:
    hint = "Y/n" if default else "y/N"
    raw = input(f"{CYAN}{prompt} [{hint}]: {RESET}").strip().lower()
    if not raw:
        return default
    return raw in ("y", "yes", "1", "true")


def detect_repo_features(target: Path) -> Dict[str, Any]:
    stacks: List[str] = []
    if (target / "go.mod").exists() or list(target.glob("cmd/**/*.go")) or list(target.glob("internal/**/*.go")) or list(target.glob("**/*.go")):
        stacks.append("Go")
    if (target / "package.json").exists() or (target / "web" / "package.json").exists():
        stacks.append("TypeScript/JS")
    if (target / "pyproject.toml").exists() or (target / "requirements.txt").exists():
        stacks.append("Python")
    if (target / "Cargo.toml").exists():
        stacks.append("Rust")
    if list(target.glob("proto/**/*.proto")):
        stacks.append("Protobuf")
    if list(target.glob("sql/**/*.sql")) or list(target.glob("migrations/**/*.sql")):
        stacks.append("SQL")
    if list(target.glob("**/schema.prisma")):
        stacks.append("Prisma")

    i18n_dir = ""
    for candidate in sorted(target.glob("**/locales/en.json")):
        rel_p = candidate.parent.relative_to(target).as_posix()
        if "node_modules" not in rel_p and ".git" not in rel_p:
            i18n_dir = rel_p
            break

    has_code = bool(stacks) or any(
        p.suffix in (".go", ".ts", ".tsx", ".py", ".rs", ".js")
        for p in target.glob("*/*")
        if p.is_file()
    )
    return {"stacks": stacks, "i18n_dir": i18n_dir, "has_existing_code": has_code}


def upsert_markdown_block(file_path: Path, block_text: str, header_if_new: str = "") -> None:
    block = block_text.strip()
    if file_path.exists():
        existing = file_path.read_text(encoding="utf-8")
        if PAK_MD_START in existing and PAK_MD_END in existing:
            before = existing.split(PAK_MD_START)[0].rstrip()
            after = existing.split(PAK_MD_END, 1)[1].lstrip()
            parts = [p for p in (before, block, after) if p]
            file_path.write_text("\n\n".join(parts) + "\n", encoding="utf-8")
        else:
            file_path.write_text(existing.rstrip() + "\n\n" + block + "\n", encoding="utf-8")
    else:
        prefix = (header_if_new.strip() + "\n\n") if header_if_new.strip() else ""
        file_path.write_text(prefix + block + "\n", encoding="utf-8")


def remove_markdown_block(file_path: Path) -> None:
    if not file_path.exists():
        return
    txt = file_path.read_text(encoding="utf-8")
    if PAK_MD_START in txt and PAK_MD_END in txt:
        before = txt.split(PAK_MD_START)[0].rstrip()
        after = txt.split(PAK_MD_END, 1)[1].lstrip()
        merged = "\n\n".join(p for p in (before, after) if p).strip()
        if merged:
            file_path.write_text(merged + "\n", encoding="utf-8")
        else:
            file_path.unlink()


def make_executable(p: Path) -> None:
    p.chmod(p.stat().st_mode | stat.S_IXUSR | stat.S_IXGRP | stat.S_IXOTH)


def sync_skill_tree(src_skill: Path, dst_skill: Path, include_openai_yaml: bool) -> None:
    """Updates skill templates (`SKILL.md`, `agents/openai.yaml`) while strictly preserving project-curated `references/`."""
    preserved_refs: Dict[str, bytes] = {}
    refs_dir = dst_skill / "references"
    if not dst_skill.is_symlink() and refs_dir.is_dir():
        for ref_file in refs_dir.rglob("*"):
            if ref_file.is_file():
                preserved_refs[ref_file.relative_to(refs_dir).as_posix()] = ref_file.read_bytes()

    if dst_skill.is_symlink() or dst_skill.exists():
        if dst_skill.is_symlink() or dst_skill.is_file():
            dst_skill.unlink()
        else:
            shutil.rmtree(dst_skill)

    shutil.copytree(src_skill, dst_skill)
    if not include_openai_yaml:
        openai_dir = dst_skill / "agents"
        if openai_dir.exists():
            shutil.rmtree(openai_dir)

    for rel_ref, content in preserved_refs.items():
        restored = dst_skill / "references" / rel_ref
        restored.parent.mkdir(parents=True, exist_ok=True)
        restored.write_bytes(content)


def configure_agy_hooks(target: Path) -> None:
    hooks_path = target / ".agents" / "hooks.json"
    hooks_path.parent.mkdir(parents=True, exist_ok=True)
    data: Dict[str, Any] = {}
    if hooks_path.exists():
        try:
            data = json.loads(hooks_path.read_text(encoding="utf-8"))
        except Exception:
            data = {}
    data["pak-impact-gate"] = {
        "enabled": True,
        "Stop": [
            {
                "type": "command",
                "command": "../scripts/pak/verify_impact.sh --agy-hook",
                "timeout": 20,
            }
        ],
    }
    hooks_path.write_text(json.dumps(data, indent=2) + "\n", encoding="utf-8")


def configure_claude_hooks(target: Path) -> None:
    settings_path = target / ".claude" / "settings.json"
    settings_path.parent.mkdir(parents=True, exist_ok=True)
    data: Dict[str, Any] = {}
    if settings_path.exists():
        try:
            data = json.loads(settings_path.read_text(encoding="utf-8"))
        except Exception:
            data = {}

    hooks_obj = data.setdefault("hooks", {})
    stop_list: List[Any] = hooks_obj.setdefault("Stop", [])
    pak_cmd = '"$CLAUDE_PROJECT_DIR/scripts/pak/verify_impact.sh" --claude-hook'

    already_present = any("scripts/pak/verify_impact.sh" in json.dumps(entry) for entry in stop_list)
    if not already_present:
        stop_list.append(
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": pak_cmd,
                        "timeout": 20,
                    }
                ]
            }
        )
    settings_path.write_text(json.dumps(data, indent=2) + "\n", encoding="utf-8")


def configure_git_pre_commit(target: Path) -> bool:
    git_dir = target / ".git"
    if not git_dir.is_dir():
        return False
    hook_file = git_dir / "hooks" / "pre-commit"
    hook_file.parent.mkdir(parents=True, exist_ok=True)
    block = (
        f"{PAK_SH_START}\n"
        'ROOT_GIT_DIR="$(git rev-parse --show-toplevel)"\n'
        'if [ -x "$ROOT_GIT_DIR/scripts/pak/verify_impact.sh" ]; then\n'
        '    "$ROOT_GIT_DIR/scripts/pak/verify_impact.sh"\n'
        "fi\n"
        f"{PAK_SH_END}"
    )
    if hook_file.exists():
        existing = hook_file.read_text(encoding="utf-8")
        if PAK_SH_START in existing and PAK_SH_END in existing:
            before = existing.split(PAK_SH_START)[0].rstrip()
            after = existing.split(PAK_SH_END, 1)[1].lstrip()
            content = "\n\n".join(p for p in (before, block, after) if p) + "\n"
        else:
            content = existing.rstrip() + "\n\n" + block + "\n"
    else:
        content = "#!/usr/bin/env bash\nset -e\n\n" + block + "\n"
    hook_file.write_text(content, encoding="utf-8")
    make_executable(hook_file)
    return True


def infer_existing_hooks_mode(target: Path, cfg: Dict[str, Any]) -> str:
    saved = cfg.get("hooks_mode", "")
    if saved in ("both", "ai", "git", "none"):
        return saved
    has_ai = (target / ".agents" / "hooks.json").exists() or (target / ".claude" / "settings.json").exists()
    git_hook = target / ".git" / "hooks" / "pre-commit"
    has_git = git_hook.exists() and PAK_SH_START in git_hook.read_text(encoding="utf-8", errors="replace")
    if has_ai and has_git:
        return "both"
    if has_ai:
        return "ai"
    if has_git:
        return "git"
    return "both"


def apply_engine_skills_rules_and_hooks(
    target: Path,
    agents: Set[str],
    hooks_mode: str,
) -> bool:
    """Installs or upgrades stateless `pak` engine scripts, skills, fenced rule blocks, hooks, and SQLite Atlas."""
    # A. Engine scripts (`scripts/pak/*`)
    dst_scripts = target / "scripts" / "pak"
    dst_scripts.mkdir(parents=True, exist_ok=True)
    for script_name in ENGINE_SCRIPTS:
        src = TEMPLATES_DIR / "scripts" / "pak" / script_name
        dst = dst_scripts / script_name
        shutil.copy2(src, dst)
        make_executable(dst)

    # B. Skills (`.agents/skills/pak-*` & `.claude/skills/pak-*`, preserving project `references/`)
    needs_agents_skills = bool(agents & {"google", "openai"})
    include_openai_meta = "openai" in agents

    if needs_agents_skills:
        agents_skills_root = target / ".agents" / "skills"
        agents_skills_root.mkdir(parents=True, exist_ok=True)
        for sname in SKILL_NAMES:
            sync_skill_tree(TEMPLATES_DIR / "skills" / sname, agents_skills_root / sname, include_openai_meta)

    if "anthropic" in agents:
        claude_skills_root = target / ".claude" / "skills"
        claude_skills_root.mkdir(parents=True, exist_ok=True)
        for sname in SKILL_NAMES:
            dst_c = claude_skills_root / sname
            if needs_agents_skills:
                if dst_c.is_symlink() or dst_c.exists():
                    if dst_c.is_symlink() or dst_c.is_file():
                        dst_c.unlink()
                    else:
                        shutil.rmtree(dst_c)
                try:
                    os.symlink(Path("../../.agents/skills") / sname, dst_c)
                except OSError:
                    sync_skill_tree(TEMPLATES_DIR / "skills" / sname, dst_c, False)
            else:
                sync_skill_tree(TEMPLATES_DIR / "skills" / sname, dst_c, False)

    # C. Lean Always-On Rules (`<!-- PAK:START --> ... <!-- PAK:END -->`)
    snippet = (TEMPLATES_DIR / "AGENTS.snippet.md").read_text(encoding="utf-8")
    if not needs_agents_skills and "anthropic" in agents:
        snippet = snippet.replace(".agents/skills/", ".claude/skills/")

    if agents & {"google", "openai"}:
        upsert_markdown_block(target / "AGENTS.md", snippet, f"# {target.name} — Agent Rules")
    if "google" in agents:
        gemini_pointer = (
            f"{PAK_MD_START}\n"
            "## Project Awareness Kit (`pak`)\n"
            "Follow all reuse, blast-radius, microservice-contract, and domain-dossier rules in `AGENTS.md` (`docs/atlas/*` & `docs/domains/*`).\n"
            f"{PAK_MD_END}"
        )
        upsert_markdown_block(target / "GEMINI.md", gemini_pointer)
    if "anthropic" in agents:
        claude_snippet = snippet if not (target / "AGENTS.md").exists() else (
            f"{PAK_MD_START}\n"
            "## Project Awareness Kit (`pak`)\n"
            "Read and strictly follow `@AGENTS.md` for `pak-atlas`, `pak-impact`, and `pak-domains` workflows (`docs/atlas/*` & `docs/domains/*`).\n"
            f"{PAK_MD_END}"
        )
        upsert_markdown_block(target / "CLAUDE.md", claude_snippet, f"# {target.name} — Claude Code Rules")

    # D. Lifecycle Hooks
    git_hook_installed = False
    if hooks_mode in ("both", "ai"):
        if "google" in agents:
            configure_agy_hooks(target)
        if "anthropic" in agents:
            configure_claude_hooks(target)
    if hooks_mode in ("both", "git"):
        git_hook_installed = configure_git_pre_commit(target)

    # E. Seed starter domain dossier if empty & refresh incremental SQLite Atlas
    domains_dir = target / "docs" / "domains"
    domains_dir.mkdir(parents=True, exist_ok=True)
    if not list(domains_dir.glob("*.md")):
        shutil.copy2(
            TEMPLATES_DIR / "domains" / "00-core-architecture.md",
            domains_dir / "00-core-architecture.md",
        )

    subprocess.run([sys.executable, str(dst_scripts / "build_atlas.py")], cwd=str(target), check=True)
    return git_hook_installed


def parse_agents_arg(raw: str) -> Set[str]:
    items = {x.strip().lower() for x in raw.split(",") if x.strip()}
    if "all" in items or not items:
        return {"google", "anthropic", "openai"}
    valid = {"google", "anthropic", "openai"}
    unknown = items - valid
    if unknown:
        raise ValueError(f"Unknown agent target(s): {unknown}. Valid: all, google, anthropic, openai")
    return items


def cmd_init(args: argparse.Namespace) -> int:
    target = Path(args.target).expanduser().resolve()
    target.mkdir(parents=True, exist_ok=True)
    detected = detect_repo_features(target)

    cfg_path = target / "pak.config.json"
    existing_cfg: Dict[str, Any] = {}
    if cfg_path.exists():
        try:
            existing_cfg = json.loads(cfg_path.read_text(encoding="utf-8"))
        except Exception:
            existing_cfg = {}

    print(f"{BOLD}{CYAN}==> pak v{PAK_VERSION} (Project Awareness Kit) Installer{RESET}")
    print(f"    Target project : {target}")
    if detected["stacks"]:
        print(f"    Detected stack : {', '.join(detected['stacks'])}")

    interactive = sys.stdin.isatty() and not args.yes

    if args.agents:
        agents = parse_agents_arg(args.agents)
    elif interactive:
        choice = ask_choice(
            "1. Which AI CLI / IDE ecosystems should pak configure?",
            [
                ("all", "All — Google (Antigravity/Gemini CLI) + Anthropic (Claude Code) + OpenAI (Codex CLI)"),
                ("google", "Google only — Antigravity (`agy` / IDE) & Gemini CLI"),
                ("anthropic", "Anthropic only — Claude Code (`claude` CLI / IDE)"),
                ("openai", "OpenAI only — Codex CLI (`codex`) & standard `AGENTS.md` IDEs"),
                ("custom", "Custom combination (e.g. google,anthropic)"),
            ],
            default_idx=1,
        )
        if choice == "custom":
            raw_custom = input(f"{CYAN}Enter comma-separated list (google,anthropic,openai): {RESET}").strip()
            agents = parse_agents_arg(raw_custom or "all")
        else:
            agents = parse_agents_arg(choice)
    elif existing_cfg.get("agents"):
        agents = set(existing_cfg["agents"])
    else:
        agents = {"google", "anthropic", "openai"}

    if args.stage:
        stage = args.stage
    elif interactive:
        default_stage = 1 if detected["has_existing_code"] else 2
        stage = ask_choice(
            "2. What stage is this project in?",
            [
                ("existing", "Existing / complex codebase (build SQLite Atlas now + install /pak-bootstrap audit)"),
                ("greenfield", "Brand-new / greenfield project (seed starter domain dossier & SQLite Atlas)"),
            ],
            default_idx=default_stage,
        )
    else:
        stage = "existing" if detected["has_existing_code"] else "greenfield"

    if args.hooks:
        hooks_mode = args.hooks
    elif interactive:
        hooks_mode = ask_choice(
            "3. Which zero-token verification gates should run automatically?",
            [
                ("both", "Both AI Stop hooks (.agents/hooks.json + .claude/settings.json) AND Git pre-commit hook"),
                ("ai", "AI Stop lifecycle hooks only (0 LLM tokens when checks pass)"),
                ("git", "Git pre-commit hook only (.git/hooks/pre-commit)"),
                ("none", "Manual CLI checks only (`pak check` / `scripts/pak/verify_impact.sh`)"),
            ],
            default_idx=1,
        )
    elif existing_cfg:
        hooks_mode = infer_existing_hooks_mode(target, existing_cfg)
    else:
        hooks_mode = "both"

    prev_checks = existing_cfg.get("checks", {})
    enforce_uuid_v7 = True if args.uuid_v7 else bool(prev_checks.get("enforce_uuid_v7", False))
    i18n_dir = (
        args.i18n_dir
        if args.i18n_dir is not None
        else prev_checks.get("i18n_locales_dir", detected["i18n_dir"])
    )
    linked_repos = [x.strip() for x in (args.link_repos or "").split(",") if x.strip()]

    if interactive and not args.uuid_v7:
        enforce_uuid_v7 = ask_yes_no(
            "4. Enforce time-ordered UUIDv7 (block UUIDv4 calls in new edits)?",
            default=enforce_uuid_v7,
        )
    if interactive and args.i18n_dir is None and detected["i18n_dir"]:
        use_i18n = ask_yes_no(
            f"5. Enforce multi-locale key parity on detected '{detected['i18n_dir']}'?",
            default=True,
        )
        i18n_dir = detected["i18n_dir"] if use_i18n else ""
    if interactive and not linked_repos:
        if ask_yes_no("6. Link sibling microservice repositories for cross-repo impact analysis?", default=False):
            raw_lr = input(f"{CYAN}Enter comma-separated relative/absolute repo paths (e.g. ../auth-svc,../web-app): {RESET}").strip()
            linked_repos = [x.strip() for x in raw_lr.split(",") if x.strip()]

    default_cfg = json.loads((TEMPLATES_DIR / "pak.config.default.json").read_text(encoding="utf-8"))
    cfg = existing_cfg if existing_cfg else default_cfg
    if not existing_cfg:
        cfg["project_name"] = target.name

    cfg["pak_version"] = PAK_VERSION
    cfg["agents"] = sorted(agents)
    cfg["hooks_mode"] = hooks_mode
    for k, v in default_cfg.items():
        cfg.setdefault(k, v)
    if linked_repos:
        cfg["linked_repos"] = sorted(set(cfg.get("linked_repos", []) + linked_repos))
    cfg.setdefault("checks", {})
    for ck, cv in default_cfg["checks"].items():
        cfg["checks"].setdefault(ck, cv)
    cfg["checks"]["enforce_uuid_v7"] = enforce_uuid_v7
    cfg["checks"]["i18n_locales_dir"] = i18n_dir
    cfg_path.write_text(json.dumps(cfg, indent=2) + "\n", encoding="utf-8")

    git_hook_installed = apply_engine_skills_rules_and_hooks(target, agents, hooks_mode)

    print(f"\n{GREEN}{BOLD}==> pak v{PAK_VERSION} installed successfully into {target}!{RESET}")
    print(f"    Configured ecosystems : {', '.join(sorted(agents))}")
    print(f"    Project stage         : {stage}")
    print(f"    Verification gates    : {hooks_mode}" + (" (run `pak upgrade` after `git init` for pre-commit)" if hooks_mode in ("both", "git") and not git_hook_installed else ""))
    print(f"    SQLite FTS5 cache     : {target / '.pak/index.sqlite'} (auto-gitignored)")
    if stage == "existing":
        print(f"\n{YELLOW}{BOLD}Next Step (One-Time Brownfield Audit):{RESET}")
        print("  Open your AI CLI (`agy`, `claude`, or `codex`) in that project and send:")
        print(f'  {CYAN}"Activate the pak-bootstrap skill to audit this codebase, quarantine dead docs/paths, and write docs/domains/*.md dossiers."{RESET}')
    return 0


def cmd_upgrade(args: argparse.Namespace) -> int:
    """Zero-prompt project upgrader: updates engine scripts, skill definitions, hooks & rule markers while preserving all project config & dossiers."""
    default_cfg = json.loads((TEMPLATES_DIR / "pak.config.default.json").read_text(encoding="utf-8"))
    targets = args.targets or ["."]
    rc = 0

    for raw_t in targets:
        target = Path(raw_t).expanduser().resolve()
        cfg_path = target / "pak.config.json"
        if not cfg_path.exists():
            print(f"[pak:upgrade] Skipping {target}: pak.config.json not found (run `pak init {target}` first).", file=sys.stderr)
            rc = 1
            continue

        cfg = json.loads(cfg_path.read_text(encoding="utf-8"))
        old_ver = cfg.get("pak_version", "1.x/2.0")
        agents = set(cfg.get("agents") or ["google", "anthropic", "openai"])
        hooks_mode = infer_existing_hooks_mode(target, cfg)

        # Merge any newly introduced schema defaults without overwriting ANY project setting
        ordered_cfg: Dict[str, Any] = {"pak_version": PAK_VERSION}
        for k, v in cfg.items():
            if k != "pak_version":
                ordered_cfg[k] = v
        ordered_cfg["agents"] = sorted(agents)
        ordered_cfg["hooks_mode"] = hooks_mode
        for k, v in default_cfg.items():
            ordered_cfg.setdefault(k, v)
        ordered_cfg.setdefault("checks", {})
        for ck, cv in default_cfg["checks"].items():
            ordered_cfg["checks"].setdefault(ck, cv)
        cfg_path.write_text(json.dumps(ordered_cfg, indent=2) + "\n", encoding="utf-8")

        apply_engine_skills_rules_and_hooks(target, agents, hooks_mode)
        print(
            f"{GREEN}[pak:upgrade] Upgraded {ordered_cfg.get('project_name', target.name)} ({old_ver} -> v{PAK_VERSION}){RESET}: "
            f"synced scripts/pak/*, skills, rule blocks, hooks & SQLite Atlas "
            f"(preserved pak.config.json, docs/domains/*.md & dependency-matrix.md)."
        )

    return rc


def cmd_status(args: argparse.Namespace) -> int:
    target = Path(args.target).expanduser().resolve()
    cfg_path = target / "pak.config.json"
    print(f"{BOLD}pak CLI version      :{RESET} v{PAK_VERSION} ({PAK_ROOT})")
    if not cfg_path.exists():
        print(f"{YELLOW}Project status       : NOT INSTALLED in {target} (run `pak init`){RESET}")
        return 1

    cfg = json.loads(cfg_path.read_text(encoding="utf-8"))
    proj_ver = cfg.get("pak_version", "pre-2.1")
    ver_note = f"{GREEN}(up to date){RESET}" if proj_ver == PAK_VERSION else f"{YELLOW}(upgrade available -> run `pak upgrade`){RESET}"
    domains_cnt = len(list((target / "docs" / "domains").glob("*.md"))) if (target / "docs" / "domains").exists() else 0
    indexed_cnt = 0
    db_path = target / ".pak" / "index.sqlite"
    if db_path.exists():
        try:
            conn = sqlite3.connect(str(db_path))
            indexed_cnt = conn.execute("SELECT COUNT(*) FROM files").fetchone()[0]
            conn.close()
        except Exception:
            pass

    print(f"{BOLD}Target project       :{RESET} {cfg.get('project_name', target.name)} ({target})")
    print(f"{BOLD}Project pak_version  :{RESET} v{proj_ver} {ver_note}")
    print(f"{BOLD}AI ecosystems        :{RESET} {', '.join(cfg.get('agents', []))}")
    print(f"{BOLD}Verification gates   :{RESET} {infer_existing_hooks_mode(target, cfg)}")
    print(f"{BOLD}SQLite indexed files :{RESET} {indexed_cnt} ({db_path.name if db_path.exists() else 'not built'})")
    print(f"{BOLD}Domain dossiers      :{RESET} {domains_cnt} in docs/domains/")
    print(f"{BOLD}Linked microservices :{RESET} {len(cfg.get('linked_repos', []))} {cfg.get('linked_repos', [])}")
    return 0


def cmd_link(args: argparse.Namespace) -> int:
    target = Path(args.target).expanduser().resolve()
    cfg_path = target / "pak.config.json"
    if not cfg_path.exists():
        print(f"[pak] pak.config.json not found in {target}. Run `pak init` first.", file=sys.stderr)
        return 1
    cfg = json.loads(cfg_path.read_text(encoding="utf-8"))
    existing = cfg.get("linked_repos", [])
    for s in args.siblings:
        if s not in existing:
            existing.append(s)
    cfg["linked_repos"] = existing
    cfg_path.write_text(json.dumps(cfg, indent=2) + "\n", encoding="utf-8")
    subprocess.run([sys.executable, str(target / "scripts" / "pak" / "build_atlas.py")], cwd=str(target), check=False)
    print(f"{GREEN}[pak] Linked sibling repo(s) {args.siblings} in {cfg_path}{RESET}")
    return 0


def resolve_home_dir() -> Path:
    env_home = os.environ.get("HOME", "").strip()
    return Path(env_home).expanduser() if env_home else Path.home()


def detect_login_shell() -> str:
    sh = os.environ.get("SHELL", "").strip()
    if not sh:
        try:
            import pwd
            sh = pwd.getpwuid(os.getuid()).pw_shell
        except Exception:
            sh = ""
    return Path(sh).name.lower() if sh else "sh"


def upsert_shell_rc_path(rc_path: Path, line_expr: str) -> str:
    block = f"{PAK_SH_START}\n{line_expr}\n{PAK_SH_END}"
    if rc_path.exists():
        existing = rc_path.read_text(encoding="utf-8", errors="replace")
        if PAK_SH_START in existing and PAK_SH_END in existing:
            before = existing.split(PAK_SH_START)[0].rstrip()
            after = existing.split(PAK_SH_END, 1)[1].lstrip()
            merged = "\n\n".join(p for p in (before, block, after) if p) + "\n"
            rc_path.write_text(merged, encoding="utf-8")
            return "updated"
        if ".local/bin" in existing:
            return "already_present"
        rc_path.write_text(existing.rstrip() + "\n\n" + block + "\n", encoding="utf-8")
        return "injected"
    else:
        rc_path.parent.mkdir(parents=True, exist_ok=True)
        rc_path.write_text(block + "\n", encoding="utf-8")
        return "created"


def remove_shell_rc_path(rc_path: Path) -> bool:
    if not rc_path.exists():
        return False
    txt = rc_path.read_text(encoding="utf-8", errors="replace")
    if PAK_SH_START not in txt or PAK_SH_END not in txt:
        return False
    before = txt.split(PAK_SH_START)[0].rstrip()
    after = txt.split(PAK_SH_END, 1)[1].lstrip()
    merged = "\n\n".join(p for p in (before, after) if p).strip()
    if merged:
        rc_path.write_text(merged + "\n", encoding="utf-8")
    else:
        rc_path.unlink()
    return True


def cmd_install_cli(_: argparse.Namespace) -> int:
    home = resolve_home_dir()
    bin_dir = home / ".local" / "bin"
    bin_dir.mkdir(parents=True, exist_ok=True)
    link_path = bin_dir / "pak"
    pak_exec = PAK_ROOT / "pak"
    make_executable(pak_exec)
    if link_path.is_symlink() or link_path.exists():
        link_path.unlink()
    os.symlink(pak_exec, link_path)
    print(f"{GREEN}[pak] Installed global CLI symlink: {link_path} -> {pak_exec} (v{PAK_VERSION}){RESET}")

    shell_name = detect_login_shell()
    export_line = 'export PATH="$HOME/.local/bin:$PATH"'
    fish_line = 'fish_add_path -g "$HOME/.local/bin"'

    targets: List[tuple[Path, str]] = []
    # Always configure the active login shell's primary RC file (creating ~/.zshrc on macOS/Linux zsh if absent)
    if shell_name == "zsh" or (home / ".zshrc").exists():
        targets.append((home / ".zshrc", export_line))
        if (home / ".zprofile").exists():
            targets.append((home / ".zprofile", export_line))
    if shell_name == "bash" or (home / ".bashrc").exists() or (home / ".bash_profile").exists():
        if (home / ".bashrc").exists() or shell_name == "bash":
            targets.append((home / ".bashrc", export_line))
        elif (home / ".bash_profile").exists():
            targets.append((home / ".bash_profile", export_line))
    if shell_name == "fish" or (home / ".config" / "fish" / "config.fish").exists():
        targets.append((home / ".config" / "fish" / "config.fish", fish_line))
    if not targets:
        targets.append((home / ".profile", export_line))

    touched_rcs: List[Path] = []
    for rc_file, expr in targets:
        status = upsert_shell_rc_path(rc_file, expr)
        if status in ("created", "injected", "updated"):
            touched_rcs.append(rc_file)
            print(f"{GREEN}[pak] Configured PATH in {rc_file} ({status}){RESET}")
        elif status == "already_present":
            print(f"{CYAN}[pak] PATH already includes ~/.local/bin in {rc_file}{RESET}")

    path_dirs = os.environ.get("PATH", "").split(os.pathsep)
    in_current_path = str(bin_dir) in path_dirs
    if shell_name == "zsh":
        if not in_current_path or touched_rcs:
            print(f"{YELLOW}[pak] Activate in your current zsh tab: source ~/.zshrc && rehash{RESET}")
        else:
            print(f"{CYAN}[pak] Note for open zsh tabs: run 'rehash' if zsh cached command lookups before install.{RESET}")
    elif not in_current_path or touched_rcs:
        reload_rc = touched_rcs[0] if touched_rcs else (home / ".profile")
        print(f"{YELLOW}[pak] Activate in your current shell: source {reload_rc}{RESET}")
    return 0


def cmd_passthrough(script_rel: str, target_dir: str, extra_args: List[str] | None = None) -> int:
    target = Path(target_dir).expanduser().resolve()
    script = target / "scripts" / "pak" / script_rel
    if not script.exists():
        print(f"[pak] '{script}' not found in {target}. Run `pak init {target}` first.", file=sys.stderr)
        return 1
    cmd = [sys.executable, str(script)] if script.suffix == ".py" else ["bash", str(script)]
    if extra_args:
        cmd.extend(extra_args)
    return subprocess.run(cmd, cwd=str(target), check=False).returncode


def remove_agy_hooks(target: Path) -> None:
    hooks_path = target / ".agents" / "hooks.json"
    if not hooks_path.exists():
        return
    try:
        data = json.loads(hooks_path.read_text(encoding="utf-8"))
    except Exception:
        return
    if "pak-impact-gate" in data:
        del data["pak-impact-gate"]
        if data:
            hooks_path.write_text(json.dumps(data, indent=2) + "\n", encoding="utf-8")
        else:
            hooks_path.unlink()


def remove_claude_hooks(target: Path) -> None:
    settings_path = target / ".claude" / "settings.json"
    if not settings_path.exists():
        return
    try:
        data = json.loads(settings_path.read_text(encoding="utf-8"))
    except Exception:
        return
    hooks_obj = data.get("hooks")
    if isinstance(hooks_obj, dict) and isinstance(hooks_obj.get("Stop"), list):
        hooks_obj["Stop"] = [
            entry for entry in hooks_obj["Stop"]
            if "scripts/pak/verify_impact.sh" not in json.dumps(entry)
        ]
        if not hooks_obj["Stop"]:
            del hooks_obj["Stop"]
        if not hooks_obj:
            del data["hooks"]
    if data:
        settings_path.write_text(json.dumps(data, indent=2) + "\n", encoding="utf-8")
    else:
        settings_path.unlink()


def remove_git_pre_commit(target: Path) -> None:
    hook_file = target / ".git" / "hooks" / "pre-commit"
    if not hook_file.exists():
        return
    txt = hook_file.read_text(encoding="utf-8", errors="replace")
    if PAK_SH_START not in txt or PAK_SH_END not in txt:
        return
    before = txt.split(PAK_SH_START)[0].rstrip()
    after = txt.split(PAK_SH_END, 1)[1].lstrip()
    merged = "\n\n".join(p for p in (before, after) if p).strip()
    meaningful = [
        ln.strip()
        for ln in merged.splitlines()
        if ln.strip() and ln.strip() not in ("#!/usr/bin/env bash", "#!/bin/sh", "set -e", "set -euo pipefail")
    ]
    if meaningful:
        hook_file.write_text(merged + "\n", encoding="utf-8")
    else:
        hook_file.unlink()


def prune_empty_dirs(candidates: List[Path]) -> None:
    for d in candidates:
        if d.exists() and d.is_dir() and not d.is_symlink():
            try:
                if not any(d.iterdir()):
                    d.rmdir()
            except OSError:
                pass


def cmd_uninstall(args: argparse.Namespace) -> int:
    target = Path(args.target).expanduser().resolve()
    for md in ("AGENTS.md", "GEMINI.md", "CLAUDE.md"):
        remove_markdown_block(target / md)
    for sname in SKILL_NAMES:
        for base in (target / ".agents" / "skills" / sname, target / ".claude" / "skills" / sname):
            if base.is_symlink() or base.is_file():
                base.unlink()
            elif base.is_dir():
                shutil.rmtree(base)

    remove_agy_hooks(target)
    remove_claude_hooks(target)
    remove_git_pre_commit(target)

    dirs_to_delete = [target / "scripts" / "pak", target / ".pak", target / "docs" / "atlas"]
    if args.purge:
        dirs_to_delete.append(target / "docs" / "domains")
        cfg_file = target / "pak.config.json"
        if cfg_file.exists():
            cfg_file.unlink()

    for d in dirs_to_delete:
        if d.is_dir():
            shutil.rmtree(d)

    prune_empty_dirs([
        target / ".agents" / "skills",
        target / ".agents",
        target / ".claude" / "skills",
        target / ".claude",
        target / "scripts",
        target / "docs",
    ])

    if args.purge:
        print(f"{GREEN}[pak] Purged all pak files, hooks, skills, cache, docs/atlas/, docs/domains/, and pak.config.json from {target}.{RESET}")
    else:
        print(f"{GREEN}[pak] Removed pak rules, hooks, skills, SQLite cache, scripts/pak/, and docs/atlas/ from {target} (preserved docs/domains/ and pak.config.json; pass --purge to remove those too).{RESET}")
    return 0


def cmd_uninstall_cli(_: argparse.Namespace) -> int:
    home = resolve_home_dir()
    link_path = home / ".local" / "bin" / "pak"
    if link_path.is_symlink() or link_path.exists():
        link_path.unlink()
        print(f"{GREEN}[pak] Removed global CLI symlink: {link_path}{RESET}")
    else:
        print(f"{YELLOW}[pak] Global CLI symlink not found at {link_path} (already removed).{RESET}")

    for rc in (
        home / ".zshrc",
        home / ".zprofile",
        home / ".bashrc",
        home / ".bash_profile",
        home / ".profile",
        home / ".config" / "fish" / "config.fish",
    ):
        if remove_shell_rc_path(rc):
            print(f"{GREEN}[pak] Removed pak PATH block from {rc}{RESET}")

    print(f"To remove the pak repository itself, run: rm -rf {PAK_ROOT}")
    return 0


def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(
        prog="pak",
        description=f"pak v{PAK_VERSION} (Project Awareness Kit) — Sub-second SQLite context, anti-duplication, microservice contract & blast-radius guardrails for AI coding agents.",
    )
    p.add_argument("-v", "--version", action="version", version=f"pak {PAK_VERSION}")
    sub = p.add_subparsers(dest="command")

    p_init = sub.add_parser("init", help="Install pak in a target project (interactive by default)")
    p_init.add_argument("target", nargs="?", default=".", help="Target project directory")
    p_init.add_argument("-y", "--yes", action="store_true", help="Non-interactive mode")
    p_init.add_argument("--agents", default="", help="Agents: all | google,anthropic,openai")
    p_init.add_argument("--stage", choices=["existing", "greenfield"], default="", help="Project stage")
    p_init.add_argument("--hooks", choices=["both", "ai", "git", "none"], default="", help="Verification gate mode")
    p_init.add_argument("--uuid-v7", action="store_true", help="Enable UUIDv7 invariant check")
    p_init.add_argument("--i18n-dir", default=None, help="Relative path to JSON locale catalogs")
    p_init.add_argument("--link-repos", default="", help="Comma-separated sibling microservice repo paths")

    p_up = sub.add_parser("upgrade", help="Zero-prompt upgrade of engine, skills, hooks & rule blocks (preserves config & dossiers)")
    p_up.add_argument("targets", nargs="*", help="One or more project directories to upgrade (default: .)")

    p_st = sub.add_parser("status", help="Show pak version alignment, active hooks, SQLite index & domain dossier count")
    p_st.add_argument("target", nargs="?", default=".")

    p_link = sub.add_parser("link", help="Link one or more sibling microservice repositories for federated contract checks")
    p_link.add_argument("siblings", nargs="+", help="Relative or absolute paths to sibling pak-enabled repos")
    p_link.add_argument("--target", default=".", help="Target project directory (default: .)")

    sub.add_parser("install-cli", help="Symlink `pak` into ~/.local/bin/pak")
    sub.add_parser("uninstall-cli", help="Remove the global ~/.local/bin/pak symlink")

    p_atlas = sub.add_parser("atlas", help="Incrementally update SQLite index & docs/atlas/* (<50ms)")
    p_atlas.add_argument("target", nargs="?", default=".")

    p_trace = sub.add_parser("trace", help="Trace FTS5 symbols, reverse dependents, sibling microservices & domain dossiers")
    p_trace.add_argument("query", help="Symbol, table, RPC, event topic, or component to trace")
    p_trace.add_argument("target", nargs="?", default=".")

    p_aff = sub.add_parser("affected", help="Compute (or --run) ONLY the minimal unit tests impacted by current git diff")
    p_aff.add_argument("--run", action="store_true", help="Execute impacted test commands immediately")
    p_aff.add_argument("target", nargs="?", default=".")

    p_check = sub.add_parser("check", help="Run deterministic contract, duplicate, dependency, codegen & evolution checks")
    p_check.add_argument("target", nargs="?", default=".")

    p_un = sub.add_parser("uninstall", help="Cleanly remove pak hooks, skills, cache, atlas & rule blocks (--purge for full wipe)")
    p_un.add_argument("--purge", action="store_true", help="Also delete pak.config.json and docs/domains/")
    p_un.add_argument("target", nargs="?", default=".")

    return p


def main() -> int:
    parser = build_parser()
    args = parser.parse_args()
    if not args.command:
        parser.print_help()
        return 0
    if args.command == "init":
        return cmd_init(args)
    if args.command == "upgrade":
        return cmd_upgrade(args)
    if args.command == "status":
        return cmd_status(args)
    if args.command == "link":
        return cmd_link(args)
    if args.command == "install-cli":
        return cmd_install_cli(args)
    if args.command == "uninstall-cli":
        return cmd_uninstall_cli(args)
    if args.command == "atlas":
        return cmd_passthrough("build_atlas.py", args.target)
    if args.command == "trace":
        return cmd_passthrough("blast_radius.sh", args.target, [args.query])
    if args.command == "affected":
        extra = ["--run"] if args.run else []
        return cmd_passthrough("affected_tests.py", args.target, extra)
    if args.command == "check":
        return cmd_passthrough("verify_impact.sh", args.target)
    if args.command == "uninstall":
        return cmd_uninstall(args)
    return 1


if __name__ == "__main__":
    sys.exit(main())
